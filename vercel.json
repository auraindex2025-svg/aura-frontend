{
  "rewrites": [
    { "source": "/verify", "destination": "/aura-verify.html" },
    { "source": "/verify/:case_id", "destination": "/aura-verify.html" },
    { "source": "/certificate/:case_id", "destination": "/aura-certificate.html" },
    { "source": "/print", "destination": "/aura-certificate-print.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
